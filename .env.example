# Supabase project keys -- see requirements/AUDIT.md #4 for what depends on these.
# Anon key is called the publishable key in newer Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely -- never import from a use-client file,
# never prefix with NEXT_PUBLIC_. Used by payment-webhook code once that exists.
SUPABASE_SERVICE_ROLE_KEY=

# /admin is gated on a Supabase session with app_metadata.role === admin
# (src/proxy.ts). Fails closed (503) if the two vars above are not set.
