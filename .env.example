# Supabase project keys -- see requirements/AUDIT.md #4 for what depends on these.
# Anon key is called the publishable key in newer Supabase projects.
# Get these: supabase.com -> New project -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS entirely -- never import from a use-client file,
# never prefix with NEXT_PUBLIC_. Used by payment-webhook code once that exists.
SUPABASE_SERVICE_ROLE_KEY=

# /admin is gated on a Supabase session with app_metadata.role === admin
# (src/proxy.ts). Fails closed (503) if the two vars above are not set.


# --- Everything below: not consumed by any code yet -----------------------
# Placeholders only, matching aglaowner-data-architecture.html section 00
# ("Pending & how to unblock each one"). Fill in as each integration gets
# built -- until then these are documentation, not live config.

# SMS / OTP provider (Twilio, Vonage, or MSG91) -- NOT an app env var.
# Configured inside the Supabase dashboard itself: Authentication ->
# Sign In / Providers -> Phone, once a Supabase project exists. Nothing to
# add here; listed for completeness.

# Payment gateway (Razorpay or Cashfree) -- unblocks "Pay & go live"
# actually charging and activating a listing. Server-only; consumed by the
# payment webhook route once it's built (see architecture doc section 03).
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_KEY_SECRET=
PAYMENT_GATEWAY_WEBHOOK_SECRET=

# DigiLocker (apisetu.gov.in) -- unblocks real buyer identity verification.
# Slowest to obtain: an organisational registration/approval process, not a
# self-serve signup. Server-only; consumed by the buyer-verification flow
# once it's built.
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=

# Voucher provider(s) -- unblocks actually paying out referral rewards.
# Pick one or more: Xoxoday, EnKash, Pine Labs (Qwikcilver), Amazon Business.
# NOT meant to live here long-term -- store in Supabase Vault, referenced by
# voucher_providers.credential_ref (see architecture doc section 05). Only
# useful here for local testing before Vault is wired up.
VOUCHER_PROVIDER_API_KEY=
